@page "/accounts/create"
@attribute [Authorize]

@using EasyPay.Shared.DTOs.AccountManagement
@using EasyPay.Shared.DTOs.Identity
@using EasyPay.Shared.Enums.Identity
@using EasyPay.Shared.Models.AccountManagement
@using EasyPay.Web.Services
@using System.ComponentModel.DataAnnotations
@inject IAccountService AccountService
@inject IProfileService ProfileService
@inject NavigationManager NavigationManager

<PageTitle>Create New Account</PageTitle>

<div class="main-content d-flex flex-column align-items-center justify-content-center">
    <div class="w-100" style="max-width: 700px;">

        <div class="text-center mb-4">
            <h1 class="h2">Create New Account</h1>
        </div>

        <div class="glass-panel p-4 p-md-5">
            @if (isLoading)
            {
                <div class="text-center p-5">
                    <div class="spinner-border" style="width: 3rem; height: 3rem; color: var(--primary-glow);" role="status">
                        <span class="visually-hidden">Loading options...</span>
                    </div>
                </div>
            }
            else
            {
                <EditForm Model="@Model" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert" style="background-color: rgba(255, 82, 82, 0.15); border-color: var(--error-color); color: var(--text-primary);">
                            @errorMessage
                        </div>
                    }

                    <!-- Step 1: Select Account Type -->
                    <div class="mb-4">
                        <label for="accountTypeSelect" class="form-label fs-5">1. Choose an Account Type</label>
                        <InputSelect id="accountTypeSelect" class="form-select form-select-lg form-select-cyber" @bind-Value="Model.AccountTypeId" @oninput="OnAccountTypeSelected">
                            <option value="0" disabled>-- Select an account type --</option>
                            @if (accountTypes is not null)
                            {
                                @foreach (var type in accountTypes)
                                {
                                    <option value="@type.Id">@type.Title</option>
                                }
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => Model.AccountTypeId)" />
                    </div>

                    <!-- Step 2: Show Requirements -->
                    @if (isRequirementsLoading)
                    {
                        <div class="text-center p-4">
                            <div class="spinner-border spinner-border-sm" style="color: var(--primary-glow);" role="status"></div>
                        </div>
                    }
                    else if (currentRequirements is { Count: > 0 })
                    {
                        <div class="mb-4 requirements-section">
                            <h3 class="fs-5">2. Fulfill Requirements</h3>
                            <p class="text-secondary small">Your status for the selected account type is shown below. You must complete all required items to continue.</p>

                            <ul class="list-group list-group-flush">
                                @foreach (var req in currentRequirements.Where(r => r.IsRequired))
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center">
                                            @if (HasApprovedSubmission(req.AuthItemId))
                                            {
                                                <i class="bi bi-check-circle-fill me-3 text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-x-circle-fill me-3 text-danger"></i>
                                            }
                                            <span class="text-light">@req.AuthItemTitle</span>
                                        </div>
                                        @if (!HasApprovedSubmission(req.AuthItemId))
                                        {
                                            <a href="/profile" class="btn btn-outline-danger btn-sm">Complete Now</a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success">Completed</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- Step 3: Give it a Nickname -->
                    <div class="mb-4">
                        <label for="accountTitle" class="form-label fs-5">@GetStepNumber() Give it a Nickname</label>
                        <InputText id="accountTitle" class="form-control form-control-cyber" @bind-Value="Model.Title" placeholder="e.g., My Savings, Daily Spending" />
                        <ValidationMessage For="@(() => Model.Title)" />
                    </div>

                    <!-- Step 4: Create Account CTA -->
                    <div class="d-grid">
                        <button type="submit" class="btn btn-glow btn-lg" disabled="@(isSubmitting || isCreateButtonDisabled)">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span class="ms-2">Creating Account...</span>
                            }
                            else
                            {
                                <span>Create Account</span>
                            }
                        </button>
                        @if (isCreateButtonDisabled && Model.AccountTypeId > 0)
                        {
                            <p class="text-center text-warning mt-3 small">Please complete all required items before creating the account.</p>
                        }
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

<style>
    .requirements-section {
        border: 1px solid var(--border-glass);
        border-radius: 8px;
        padding: 1.25rem;
        background-color: rgba(0,0,0,0.2);
    }

        .requirements-section .list-group-item {
            background-color: transparent;
            border-color: var(--border-glass) !important;
            padding: 0.75rem 0;
        }

            .requirements-section .list-group-item:last-child {
                border-bottom: none;
            }
</style>


@code {
    private CreateAccountModel Model = new();

    private bool isLoading = true;
    private bool isRequirementsLoading = false;
    private bool isSubmitting = false;
    private bool isCreateButtonDisabled = true;

    private List<AccountTypeDto>? accountTypes;
    private List<AuthItemValueDto>? userSubmissions;
    private List<AccountTypeDocumentRequirementDto>? currentRequirements;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadAccountTypes(),
            LoadUserSubmissions()
        );
        isLoading = false;
    }

    private async Task LoadAccountTypes()
    {
        accountTypes = await AccountService.GetAccountTypes();
    }

    private async Task LoadUserSubmissions()
    {
        userSubmissions = await ProfileService.GetMySubmittedDocuments();
    }

    private async Task OnAccountTypeSelected(ChangeEventArgs e)
    {
        isRequirementsLoading = true;
        currentRequirements = null;
        isCreateButtonDisabled = true;
        StateHasChanged();

        if (int.TryParse(e.Value?.ToString(), out var selectedId) && selectedId > 0)
        {
            Model.AccountTypeId = selectedId;
            currentRequirements = await AccountService.GetRequirementsForAccountType(selectedId);
            ValidateRequirements();
        }

        isRequirementsLoading = false;
    }

    private void ValidateRequirements()
    {
        if (currentRequirements == null || !currentRequirements.Any(r => r.IsRequired))
        {
            isCreateButtonDisabled = false;
            return;
        }

        var allRequirementsMet = currentRequirements
            .Where(r => r.IsRequired)
            .All(req => HasApprovedSubmission(req.AuthItemId));

        isCreateButtonDisabled = !allRequirementsMet;
    }

    private bool HasApprovedSubmission(int authItemId)
    {
        if (userSubmissions == null || currentRequirements == null) return false;

        // Find the title for the given authItemId
        var requiredItemTitle = currentRequirements.FirstOrDefault(cr => cr.AuthItemId == authItemId)?.AuthItemTitle;
        if (requiredItemTitle == null) return false;

        // Check if there is an approved submission with that title
        return userSubmissions.Any(s =>
            s.AuthItemTitle == requiredItemTitle &&
            s.Status == VerificationStatus.Approved);
    }

    private string GetStepNumber()
    {
        return (currentRequirements is { Count: > 0 }) ? "3." : "2.";
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        var request = new CreateAccountRequest(Model.AccountTypeId, Model.Title);
        var success = await AccountService.CreateAccount(request);

        if (success)
        {
            NavigationManager.NavigateTo("/accounts");
        }
        else
        {
            errorMessage = "There was an error creating your account. Please check the details and try again.";
            isSubmitting = false;
        }
    }

    public class CreateAccountModel
    {
        [Required(ErrorMessage = "Please give your account a nickname.")]
        [StringLength(50, ErrorMessage = "The nickname is too long.")]
        public string Title { get; set; } = string.Empty;

        [Range(1, int.MaxValue, ErrorMessage = "Please select a valid account type.")]
        public int AccountTypeId { get; set; }
    }
}