@page "/verification-center"
@attribute [Authorize]

@using EasyPay.Shared.DTOs.Identity
@using EasyPay.Shared.Enums.Identity
@using EasyPay.Web.Services
@using static Shared.AuthItemCard 

@inject IProfileService ProfileService
@inject IAuthItemsService AuthItemsService

<PageTitle>Verification Center</PageTitle>

@if (isLoading)
{
    <div class="text-center mt-5">
        <div class="spinner-border" style="width: 3rem; height: 3rem; color: var(--primary-glow);" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3 text-secondary">Loading your verification status...</p>
    </div>
}
else if (authItems is null || !authItems.Any())
{
    <div class="glass-panel p-5 text-center">
        <h3>No Verification Items Found</h3>
        <p class="text-secondary">There are no verification items configured for your account at this time.</p>
    </div>
}
else
{
    <div class="glass-panel p-4 rounded-4 mb-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="h2 mb-1">Verification Center</h1>
                <p class="text-secondary mb-0">
                    Your Verification Level is currently: <strong class="text-light">Level @completionLevel</strong> (@completedItems of @totalItems items completed)
                </p>
            </div>
            <div class="col-md-4 mt-3 mt-md-0">
                <div class="progress" role="progressbar" aria-label="Verification progress" aria-valuenow="@progressPercentage" aria-valuemin="0" aria-valuemax="100" style="height: 12px; background-color: rgba(0,0,0,0.3);">
                    <div class="progress-bar" style="width: @(progressPercentage)%; background-color: var(--primary-glow);"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        @foreach (var item in authItems)
        {
            <div class="col-lg-6 mb-4">
                <AuthItemCard Item="item" />
            </div>
        }
    </div>
}

<style>
    .auth-card {
        border-radius: 16px;
        padding: 1.5rem;
        transition: transform 0.2s ease-out, box-shadow 0.2s ease-out;
        display: flex;
        flex-direction: column;
    }
    .auth-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0 15px -3px var(--primary-glow);
    }

    .status-pill {
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        border: 1px solid;
    }
    .status-completed { background-color: rgba(76, 175, 80, 0.2); color: var(--success-color); border-color: var(--success-color); }
    .status-pending { background-color: rgba(255, 179, 0, 0.2); color: var(--warning-color); border-color: var(--warning-color); }
    .status-missing { background-color: rgba(255, 82, 82, 0.2); color: var(--error-color); border-color: var(--error-color); }
    
    .btn-glow-error {
         border-radius: 8px; border: 1px solid var(--error-color); background-color: transparent; color: var(--error-color); transition: all 0.2s ease-in-out; text-decoration: none;
    }
    .btn-glow-error:hover {
        background-color: var(--error-color); color: var(--bg-color); box-shadow: 0 0 15px var(--error-color);
    }
</style>


@code {
    private bool isLoading = true;
    private List<UserAuthItemStatusViewModel> authItems;

    private int completedItems = 0;
    private int totalItems = 0;
    private int completionLevel = 0;
    private double progressPercentage = 0;

    protected override async Task OnInitializedAsync()
    {
        var submittedDocs = await ProfileService.GetMySubmittedDocuments() ?? new List<AuthItemValueDto>();

        var allPossibleAuthItems = await AuthItemsService.getAllAuthItems() ?? new List<AuthItemDto>();

        authItems = allPossibleAuthItems.Select(possibleItem => 
        {
            var userAuthItemStatusViewModel = new UserAuthItemStatusViewModel()
            {
                Title = possibleItem.Title,
                Description = possibleItem.Description
            };
            var submittedVersion = submittedDocs.FirstOrDefault(s => s.AuthItemTitle.Equals(possibleItem.Title, StringComparison.OrdinalIgnoreCase));
            if (submittedVersion != null)
            {
                userAuthItemStatusViewModel.Status = submittedVersion.Status;
                userAuthItemStatusViewModel.LastStatusChangeDate = submittedVersion.VerificationDate;
            }
            else
            {
                userAuthItemStatusViewModel.Status = VerificationStatus.Missing;
            }
            return userAuthItemStatusViewModel;
        }).ToList();
        
        CalculateProgress();
        isLoading = false;
    }

    private void CalculateProgress()
    {
        if (authItems is null || !authItems.Any()) return;
        
        completedItems = authItems.Count(i => i.Status == VerificationStatus.Approved);
        totalItems = authItems.Count;
        completionLevel = completedItems > 0 ? (int)Math.Ceiling(completedItems / 2.0) : 0;
        progressPercentage = totalItems > 0 ? (completedItems / (double)totalItems) * 100 : 0;
    }
}