@page "/"
@attribute [Authorize]

<PageTitle>Dashboard</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="dashboard-header">
            <h1>Welcome back, @(context.User.FindFirst("FirstName")?.Value ?? "User")!</h1>
            <p>Here is your financial overview for today.</p>
        </div>

        <div class="dashboard-grid">
            <div class="card account-card">
                <div class="card-header">
                    <span class="card-title">Primary Account</span>
                    <span class="account-number">**** **** **** 1234</span>
                </div>
                <div class="card-body">
                    <p class="balance-label">Available Balance</p>
                    <p class="balance-amount">$12,504.87</p>
                </div>
                <div class="card-footer">
                    <button class="btn btn-accent"><i class="bi bi-send"></i> Send Money</button>
                    <button class="btn btn-secondary"><i class="bi bi-plus-circle"></i> Add Funds</button>
                </div>
            </div>

            <div class="card transactions-card">
                <div class="card-header">
                    <span class="card-title">Recent Transactions</span>
                    <a href="/history" class="view-all">View All</a>
                </div>
                <div class="card-body">
                    <ul class="transaction-list">
                        <li>
                            <div class="transaction-icon" style="background-color: #fdf4f4;"><i class="bi bi-cup-hot-fill" style="color: #e57373;"></i></div>
                            <div class="transaction-details">
                                <span class="merchant">Starbucks</span>
                                <span class="date">Today, 2:45 PM</span>
                            </div>
                            <span class="amount outgoing">-$5.75</span>
                        </li>
                         <li>
                            <div class="transaction-icon" style="background-color: #f3f9ff;"><i class="bi bi-lightning-charge-fill" style="color: #64b5f6;"></i></div>
                            <div class="transaction-details">
                                <span class="merchant">Utility Bill</span>
                                <span class="date">Yesterday, 10:10 AM</span>
                            </div>
                            <span class="amount outgoing">-$85.30</span>
                        </li>
                        <li>
                            <div class="transaction-icon" style="background-color: #f2fbf6;"><i class="bi bi-cash-stack" style="color: #81c784;"></i></div>
                            <div class="transaction-details">
                                <span class="merchant">Work Payroll</span>
                                <span class="date">Sep 12, 2025</span>
                            </div>
                            <span class="amount incoming">+$2,450.00</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </Authorized>
</AuthorizeView>