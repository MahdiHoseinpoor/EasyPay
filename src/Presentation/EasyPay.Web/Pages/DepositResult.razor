@page "/deposit-result"
@layout Layout.MainLayout
@inject NavigationManager NavigationManager

<PageTitle>Deposit Result</PageTitle>
<div class="d-flex align-items-center justify-content-center" style="min-height: 70vh;">
    <div class="glass-panel" style="text-align: center; max-width: 500px; width: 100%; padding: 2.5rem;">
@if (isSuccess.HasValue)
{
    @if (isSuccess.Value)
    {
        <div class="text-center">
            <i class="bi bi-check-circle-fill display-1 text-success mb-3"></i>
            <h2 class="mb-3">Deposit Successful!</h2>
            <p class="text-secondary">
                Your account has been credited. The new balance will be reflected in your dashboard.
            </p>
            <a href="/" class="btn btn-glow mt-4"><i class="bi bi-grid-1x2-fill me-2"></i>Back to Dashboard</a>
        </div>
    }
    else
    {
        <div class="text-center">
            <i class="bi bi-x-circle-fill display-1 text-danger mb-3"></i>
            <h2 class="mb-3">Deposit Failed</h2>
            <p class="text-secondary">
                @FailureMessage
            </p>
            <a href="/deposit" class="btn btn-outline-light mt-4"><i class="bi bi-arrow-clockwise me-2"></i>Try Again</a>
        </div>
    }
}
else
{
    <div class="text-center">
        <div class="spinner-border" style="width: 3rem; height: 3rem; color: var(--primary-glow);" role="status">
            <span class="visually-hidden">Processing...</span>
        </div>
        <p class="mt-3 text-secondary">Verifying payment status...</p>
    </div>
}
    </div>
</div>
@code {
    [SupplyParameterFromQuery]
    public string? Status { get; set; }

    [SupplyParameterFromQuery]
    public string? Message { get; set; }

    private bool? isSuccess;
    private string FailureMessage =>
        string.IsNullOrEmpty(Message)
        ? "The payment was not completed or was cancelled. Your account has not been charged."
        : Uri.UnescapeDataString(Message);

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Status))
        {
            isSuccess = Status.Equals("success", StringComparison.OrdinalIgnoreCase);
        }
        else
        {
            isSuccess = false;
        }
    }
}