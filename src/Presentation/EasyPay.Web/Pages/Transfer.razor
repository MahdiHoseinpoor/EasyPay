@page "/transfer"
@attribute [Authorize]
@implements IDisposable

@using EasyPay.Shared.DTOs.AccountManagement
@using EasyPay.Shared.Models.Report
@using EasyPay.Web.Services
@using System.ComponentModel.DataAnnotations

@inject IProfileService ProfileService
@inject ITransactionService TransactionService
@inject NavigationManager NavigationManager
@inject CurrencyService CurrencyService

<PageTitle>Internal Transfer</PageTitle>

<div class="main-content d-flex flex-column align-items-center justify-content-center">
    <div class="w-100" style="max-width: 600px;">

        @if (isLoading)
        {
            <div class="text-center mt-5">
                <div class="spinner-border" style="width: 3rem; height: 3rem; color: var(--primary-glow);" role="status">
                    <span class="visually-hidden">Loading accounts...</span>
                </div>
            </div>
        }
        else if (myAccounts is null || myAccounts.Count < 2)
        {
            <div class="glass-panel p-4 p-md-5 rounded-4 text-center">
                <i class="bi bi-exclamation-triangle-fill fs-1 text-warning"></i>
                <h3 class="mt-3">Transfer Unavailable</h3>
                <p class="text-secondary">You need at least two accounts to perform a transfer.</p>
                <button class="btn btn-glow mt-3" @onclick='() => NavigationManager.NavigateTo("/accounts/create")'>
                    Create Another Account
                </button>
            </div>
        }
        else
        {
            <div class="glass-panel p-4 p-md-5 rounded-4">
                <h1 class="h2 text-center mb-4">Transfer Between Accounts</h1>

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success d-flex align-items-center" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        <div>@successMessage</div>
                    </div>
                }

                <EditForm Model="@Model" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />

                    <!-- Source Account -->
                    <div class="mb-3">
                        <label for="sourceAccount" class="form-label">From</label>
                        <InputSelect id="sourceAccount" class="form-select form-select-lg form-select-cyber" @bind-Value="Model.SourceAccountId">
                            <option value="@Guid.Empty">-- Select an account --</option>
                            @foreach (var account in myAccounts)
                            {
                                <option value="@account.Id">@account.Title - @CurrencyService.Format(account.CurrentBalance) @CurrencyService.GetCurrencySymbol()</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => Model.SourceAccountId)" />
                    </div>

                    <!-- Arrow Icon -->
                    <div class="text-center my-3"><i class="bi bi-arrow-down fs-2" style="color: var(--primary-glow);"></i></div>

                    <!-- Destination Account -->
                    <div class="mb-4">
                        <label for="destinationAccount" class="form-label">To</label>
                        <InputSelect id="destinationAccount" class="form-select form-select-lg form-select-cyber" @bind-Value="Model.DestinationAccountId">
                            <option value="@Guid.Empty">-- Select an account --</option>
                            @foreach (var account in myAccounts.Where(a => a.Id != Model.SourceAccountId))
                            {
                                <option value="@account.Id">@account.Title - @CurrencyService.Format(account.CurrentBalance) @CurrencyService.GetCurrencySymbol()</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => Model.DestinationAccountId)" />
                    </div>

                    <!-- Amount Input -->
                    <div class="mb-4">
                        <label for="transferAmount" class="form-label">Amount (@CurrencyService.GetCurrencySymbol())</label>
                        <div class="input-group">
                            <span class="input-group-text form-control-cyber">@CurrencyService.GetCurrencySymbol()</span>
                            <InputNumber id="transferAmount" class="form-control form-control-lg form-control-cyber" placeholder="0" TValue="decimal" @bind-Value="Model.Amount" />
                        </div>
                        <ValidationMessage For="@(() => Model.Amount)" />
                    </div>

                    <!-- Note -->
                    <div class="mb-4">
                        <label for="transferNote" class="form-label">Note (Optional)</label>
                        <InputText id="transferNote" class="form-control form-control-cyber" @bind-Value="Model.Description" placeholder="e.g., For monthly savings" />
                        <ValidationMessage For="@(() => Model.Description)" />
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" style="background-color: rgba(255, 82, 82, 0.15); border-color: var(--error-color); color: var(--text-primary);">
                            @errorMessage
                        </div>
                    }

                    <!-- CTA -->
                    <div class="d-grid">
                        <button type="submit" class="btn btn-glow btn-lg" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span class="ms-2">Processing...</span>
                            }
                            else
                            {
                                <span>Review Transfer</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        }
    </div>
</div>

@code {
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? errorMessage;
    private string? successMessage;
    private List<AccountDto> myAccounts = new();
    private TransferModel Model = new();

    protected override async Task OnInitializedAsync()
    {
        CurrencyService.OnCurrencyChange += StateHasChanged;
        myAccounts = await ProfileService.GetMyAccounts();
        isLoading = false;
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        var sourceAccount = myAccounts.FirstOrDefault(a => a.Id == Model.SourceAccountId);
        var destinationAccount = myAccounts.FirstOrDefault(a => a.Id == Model.DestinationAccountId);

        if (sourceAccount is null || destinationAccount is null)
        {
            errorMessage = "Please select both a source and destination account.";
            isSubmitting = false;
            return;
        }

        if (sourceAccount.Id == destinationAccount.Id)
        {
            errorMessage = "Source and destination accounts cannot be the same.";
            isSubmitting = false;
            return;
        }

        decimal amountInRial = (CurrencyService.CurrentCurrency == CurrencyDisplay.Toman)
            ? Model.Amount * 10
            : Model.Amount;

        if (amountInRial <= 0)
        {
            errorMessage = "Transfer amount must be positive.";
            isSubmitting = false;
            return;
        }

        if (amountInRial > sourceAccount.CurrentBalance)
        {
            errorMessage = "Insufficient funds in the source account.";
            isSubmitting = false;
            return;
        }

        var request = new TransferMoneyRequest(
            Model.SourceAccountId,
            destinationAccount.AccountNumber,
            amountInRial,
            Model.Description
        );

        var success = await TransactionService.TransferMoney(request);

        if (success)
        {
            successMessage = $"Successfully transferred {Model.Amount:N0} {CurrencyService.GetCurrencySymbol()} to {destinationAccount.Title}.";
            Model = new();
            myAccounts = await ProfileService.GetMyAccounts();
        }
        else
        {
            errorMessage = "The transfer could not be completed. Please try again later.";
        }

        isSubmitting = false;
    }

    public class TransferModel
    {
        [Required(ErrorMessage = "Please select a source account.")]
        [RegularExpression(@"^({)?[a-fA-F0-9]{8}-([a-fA-F0-9]{4}-){3}[a-fA-F0-9]{12}(})?$", ErrorMessage = "Please select a valid source account.")]
        public Guid SourceAccountId { get; set; }

        [Required(ErrorMessage = "Please select a destination account.")]
        [RegularExpression(@"^({)?[a-fA-F0-9]{8}-([a-fA-F0-9]{4}-){3}[a-fA-F0-9]{12}(})?$", ErrorMessage = "Please select a valid destination account.")]
        public Guid DestinationAccountId { get; set; }

        [Required(ErrorMessage = "Please enter an amount.")]
        [Range(typeof(decimal), "1", "1000000000", ErrorMessage = "Amount is out of valid range.")]
        public decimal Amount { get; set; }

        [StringLength(100, ErrorMessage = "Note is too long.")]
        public string? Description { get; set; }
    }

    public void Dispose()
    {
        CurrencyService.OnCurrencyChange -= StateHasChanged;
    }
}