@page "/transfer"
@attribute [Authorize]
@implements IDisposable

@using EasyPay.Shared.DTOs.AccountManagement
@using EasyPay.Shared.Models.Report
@using EasyPay.Web.Services
@using System.ComponentModel.DataAnnotations

@inject IProfileService ProfileService
@inject ITransactionService TransactionService
@inject IAccountService AccountService
@inject NavigationManager NavigationManager
@inject CurrencyService CurrencyService

<PageTitle>Send Money</PageTitle>

<div class="main-content d-flex flex-column align-items-center justify-content-center">
    <div class="w-100" style="max-width: 600px;">

        @if (isLoading)
        {
            <div class="text-center mt-5">
                <div class="spinner-border text-info" role="status"></div>
            </div>
        }
        else if (myAccounts is null || !myAccounts.Any())
        {
            <div class="glass-panel p-5 text-center">
                <h3 class="mt-3">No Accounts Found</h3>
                <p class="text-secondary">You need at least one account to send money.</p>
                <button class="btn btn-glow mt-2" @onclick='() => NavigationManager.NavigateTo("/accounts/create")'>Create an Account</button>
            </div>
        }
        else
        {
            <div class="glass-panel p-4 p-md-5 rounded-4">
                <h1 class="h2 text-center mb-4">Send Money</h1>

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success d-flex align-items-center" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        <div>@successMessage</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger" style="background-color: rgba(255, 82, 82, 0.15); border-color: var(--error-color); color: var(--text-primary);">
                        @errorMessage
                    </div>
                }

                <EditForm Model="@Model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <!-- Source Account -->
                    <div class="mb-3">
                        <label for="sourceAccount" class="form-label">From</label>
                        <InputSelect id="sourceAccount" class="form-select form-select-lg form-select-cyber" @bind-Value="Model.SourceAccountId" @bind-Value:after="OnSourceAccountChanged">
                            <option value="@Guid.Empty">-- Select an account --</option>
                            @foreach (var account in myAccounts)
                            {
                                <option value="@account.Id">@account.Title - @CurrencyService.Format(account.CurrentBalance) @CurrencyService.GetCurrencySymbol()</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => Model.SourceAccountId)" />
                    </div>

                    <!-- Destination Account Number Input -->
                    <div class="mb-3">
                        <label for="destinationAccount" class="form-label">To Account Number</label>
                        <div class="input-group">
                            <InputText id="destinationAccount" class="form-control form-control-lg form-control-cyber" @bind-Value="Model.DestinationAccountNumber" disabled="@(currentState == InquiryState.Confirm)" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="HandleInquiry" disabled="@(isCheckingAccount || currentState == InquiryState.Confirm)">
                                @if (isCheckingAccount)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <span>Inquire</span>
                                }
                            </button>
                        </div>
                        <ValidationMessage For="@(() => Model.DestinationAccountNumber)" />
                    </div>

                    @if (currentState == InquiryState.Confirm && destinationAccountHolder != null)
                    {
                        <!-- Confirmation and Amount Section -->
                        <div class="p-3 rounded-3 mb-4" style="background-color: rgba(0,255,224,0.05); border: 1px solid var(--primary-glow);">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-secondary">Recipient:</small>
                                    <h5 class="mb-0">@destinationAccountHolder.FullName</h5>
                                    <small class="text-secondary">@destinationAccountHolder.AccountTitle</small>
                                </div>
                                <button type="button" class="btn btn-sm btn-link-cyber" @onclick="ResetInquiry">Change</button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="transferAmount" class="form-label">Amount (@CurrencyService.GetCurrencySymbol())</label>
                            <InputNumber id="transferAmount" class="form-control form-control-lg form-control-cyber" @bind-Value="Model.Amount" TValue="decimal" />
                            <ValidationMessage For="@(() => Model.Amount)" />
                        </div>

                        <div class="mb-4">
                            <label for="transferNote" class="form-label">Note (Optional)</label>
                            <InputText id="transferNote" class="form-control form-control-cyber" @bind-Value="Model.Description" />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-glow btn-lg" disabled="@isSubmitting">
                                @(isSubmitting ? "Sending..." : "Confirm & Send")
                            </button>
                        </div>
                    }
                </EditForm>
            </div>
        }
    </div>
</div>

@code {
    private enum InquiryState { Input, Confirm }

    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool isCheckingAccount = false;
    private string? errorMessage;
    private string? successMessage;

    private List<AccountDto> myAccounts = new();
    private TransferModel Model = new();
    private InquiryState currentState = InquiryState.Input;
    private AccountHolderDto? destinationAccountHolder;

    protected override async Task OnInitializedAsync()
    {
        CurrencyService.OnCurrencyChange += StateHasChanged;
        myAccounts = await ProfileService.GetMyAccounts();
        isLoading = false;
    }

    private Task OnSourceAccountChanged()
    {
        // Side Effect: If the source account changes, the inquiry is no longer valid.
        ResetInquiry();
        return Task.CompletedTask;
    }

    private async Task HandleInquiry()
    {
        isCheckingAccount = true;
        errorMessage = null;
        successMessage = null;

        // Side Effect: Check if user is trying to send money to their own account.
        var sourceAccount = myAccounts.FirstOrDefault(a => a.Id == Model.SourceAccountId);
        if (sourceAccount?.AccountNumber == Model.DestinationAccountNumber)
        {
            errorMessage = "You cannot send money to the same account you are sending from.";
            isCheckingAccount = false;
            return;
        }

        try
        {
            destinationAccountHolder = await AccountService.InquireAccountHolderAsync(Model.DestinationAccountNumber);
            if (destinationAccountHolder != null)
            {
                currentState = InquiryState.Confirm;
            }
        }
        catch (ApiException ex)
        {
            // Side Effect: Display specific error from the API.
            errorMessage = ex.ApiError.message;
        }
        finally
        {
            isCheckingAccount = false;
            // THE FIX: Explicitly tell Blazor to re-render the component.
            StateHasChanged();
        }
    }

    private void ResetInquiry()
    {
        currentState = InquiryState.Input;
        destinationAccountHolder = null;
        Model.Amount = 0;
        Model.Description = string.Empty;
        errorMessage = null; // Clear error on reset
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        decimal amountInRial = (CurrencyService.CurrentCurrency == CurrencyDisplay.Toman) ? Model.Amount * 10 : Model.Amount;

        var request = new TransferMoneyRequest(Model.SourceAccountId, Model.DestinationAccountNumber, amountInRial, Model.Description);

        try
        {
            var success = await TransactionService.TransferMoney(request);
            if (success)
            {
                successMessage = $"Successfully sent {Model.Amount:N0} {CurrencyService.GetCurrencySymbol()} to {destinationAccountHolder?.FullName}.";
                // Side Effect: Reset form for another transfer but keep source account selected.
                var previousSource = Model.SourceAccountId;
                Model = new TransferModel { SourceAccountId = previousSource };
                ResetInquiry();
                myAccounts = await ProfileService.GetMyAccounts(); // Refresh balances
            }
        }
        catch (ApiException ex)
        {
            // Side Effect: Handle potential errors during the final submission.
            errorMessage = ex.ApiError.message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public class TransferModel
    {
        [Required(ErrorMessage = "Please select a source account.")]
        [NotDefaultGuid(ErrorMessage = "Please select a valid source account.")]
        public Guid SourceAccountId { get; set; }

        [Required(ErrorMessage = "Please enter a destination account number.")]
        [StringLength(10, MinimumLength = 10, ErrorMessage = "Account number must be 10 digits.")]
        [RegularExpression("^[0-9]*$", ErrorMessage = "Account number must only contain digits.")]
        public string DestinationAccountNumber { get; set; }

        [Required(ErrorMessage = "Please enter an amount.")]
        [Range(typeof(decimal), "1", "1000000000", ErrorMessage = "Amount is out of valid range.")]
        public decimal Amount { get; set; }

        [StringLength(100)]
        public string? Description { get; set; }
    }

    public class NotDefaultGuidAttribute : ValidationAttribute
    {
        protected override ValidationResult IsValid(object value, ValidationContext validationContext)
        {
            if (value is Guid guid && guid != Guid.Empty)
            {
                return ValidationResult.Success;
            }
            return new ValidationResult(ErrorMessage);
        }
    }

    public void Dispose()
    {
        CurrencyService.OnCurrencyChange -= StateHasChanged;
    }
}