@page "/accounts"
@attribute [Authorize]

@using EasyPay.Shared.DTOs.AccountManagement
@using EasyPay.Web.Services
@inject IProfileService ProfileService
@inject NavigationManager NavigationManager

<PageTitle>My Accounts</PageTitle>

@if (isLoading)
{
    <div class="text-center mt-5">
        <div class="spinner-border" style="width: 3rem; height: 3rem; color: var(--primary-glow);" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3 text-secondary">Fetching your accounts...</p>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2">My Accounts</h1>
        <button class="btn btn-glow" @onclick="NavigateToCreateAccount">
            <i class="bi bi-plus-lg me-2"></i>Create New Account
        </button>
    </div>

    @if (accounts is null || !accounts.Any())
    {
        <div class="glass-panel text-center p-5">
            <i class="bi bi-wallet2 fs-1" style="color: var(--primary-glow);"></i>
            <h3 class="mt-3">Your Dashboard Awaits</h3>
            <p class="text-secondary">You haven't created any accounts yet. Get started by opening your first one!</p>
            <button class="btn btn-glow mt-3" @onclick="NavigateToCreateAccount">
                Create Your First Account
            </button>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var account in accounts)
            {
                <div class="col-lg-6 mb-4">
                    <AccountCard Account="account" OnClickCallback="() => NavigateToAccountDetails(account.Id)" />
                </div>
            }
        </div>
    }
}

@code {
    private bool isLoading = true;
    private List<AccountDto> accounts;

    protected override async Task OnInitializedAsync()
    {
        accounts = await ProfileService.GetMyAccounts();
        isLoading = false;
    }

    private void NavigateToCreateAccount()
    {
        NavigationManager.NavigateTo("/accounts/create");
    }

    private void NavigateToAccountDetails(Guid accountId)
    {
        NavigationManager.NavigateTo($"/accounts/{accountId}");
    }
}