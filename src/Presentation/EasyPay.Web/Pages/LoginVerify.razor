@page "/login-verify"
@layout Layout.AuthLayout

@using System.ComponentModel.DataAnnotations
@using EasyPay.Shared.Models.Identity
@using EasyPay.Web.Services
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject AuthState AuthState

<PageTitle>Verify Code</PageTitle>

<div class="auth-card">
    <div class="card-body">
        <div class="text-center">
            <h3 class="card-title">Enter Verification Code</h3>
            <p class="card-subtitle">A 6-digit code was sent to @AuthState.PhoneNumber</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <EditForm Model="@Model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="code" class="form-label">Verification Code</label>
                <InputText id="code" @bind-Value="Model.Code" class="form-control" />
                <ValidationMessage For="@(() => Model.Code)" />
            </div>

            <div class="d-grid mt-4">
                <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <span>Verify & Continue</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private VerificationModel Model = new();
    private bool isSubmitting = false;
    private string errorMessage;

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(AuthState.PhoneNumber))
        {
            NavigationManager.NavigateTo("/login-phone");
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        var request = new AuthenticateWithPhoneRequest(AuthState.PhoneNumber, Model.Code);
        var response = await AuthService.VerifyPhone(request);

        if (response == null)
        {
            errorMessage = "Invalid or expired verification code.";
            isSubmitting = false;
            return;
        }

        switch (response.Status)
        {
            case PhoneAuthenticationStatus.LoggedIn:
                NavigationManager.NavigateTo("/");
                break;
            case PhoneAuthenticationStatus.NeedsPassword:
                NavigationManager.NavigateTo("/login-password");
                break;
            case PhoneAuthenticationStatus.NeedsRegistration:
                NavigationManager.NavigateTo("/complete-profile");
                break;
            default:
                errorMessage = "An unexpected error occurred. Please try again.";
                isSubmitting = false;
                break;
        }
    }

    public class VerificationModel
    {
        [Required]
        public string Code { get; set; }
    }
}