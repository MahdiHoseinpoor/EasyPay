@using EasyPay.Shared.DTOs.AccountManagement
@using System.Globalization
@using EasyPay.Web.Services

<div class="account-balance-chart-container">
    @if (Segments.Any())
    {
        <div class="chart-wrapper">
            <svg viewBox="-1 -1 2 2" style="transform: rotate(-90deg)">
                @foreach (var segment in Segments)
                {
                    <path d="@GetSvgArcPath(segment.StartAngle, segment.EndAngle)" fill="@segment.Color" />
                }
            </svg>
            <div class="chart-center-text">
                <div class="h6 text-secondary mb-0">Total</div>
                <div class="h4">@TotalBalanceFormatted</div>
            </div>
        </div>
        <div class="legend-wrapper">
            @foreach (var segment in Segments)
            {
                <div class="legend-item">
                    <span class="legend-color-box" style="background-color: @segment.Color;"></span>
                    <span class="legend-label">@segment.Account.Title</span>
                    <span class="legend-value">@segment.Percentage.ToString("P0")</span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center p-4 text-secondary">
            <p>No balances to display in the chart.</p>
        </div>
    }
</div>


@code {
    [Parameter, EditorRequired]
    public List<AccountDto> Accounts { get; set; } = new();

    [Inject]
    private CurrencyService CurrencyService { get; set; } = default!;

    private List<ChartSegment> Segments { get; set; } = new();
    private string TotalBalanceFormatted { get; set; } = "0";

    private readonly List<string> _colors = new() { "#00FFE0", "#00A2FF", "#9E5EFF", "#FF5E9D", "#FFC55E", "#A0E7E5" };

    protected override void OnParametersSet()
    {
        GenerateChartData();
    }

    private void GenerateChartData()
    {
        Segments.Clear();
        var positiveBalanceAccounts = Accounts.Where(a => a.CurrentBalance > 0).ToList();
        var total = positiveBalanceAccounts.Sum(a => a.CurrentBalance);

        if (total <= 0)
        {
            TotalBalanceFormatted = "0";
            return;
        }

        TotalBalanceFormatted = CurrencyService.Format(total);

        double startAngle = 0;
        int colorIndex = 0;

        foreach (var account in positiveBalanceAccounts)
        {
            double percentage = (double)(account.CurrentBalance / total);
            double sweepAngle = percentage * 360;
            double endAngle = startAngle + sweepAngle;

            Segments.Add(new ChartSegment
            {
                Account = account,
                Percentage = percentage,
                Color = _colors[colorIndex % _colors.Count],
                StartAngle = startAngle,
                EndAngle = endAngle
            });

            startAngle = endAngle;
            colorIndex++;
        }
    }

    private string GetSvgArcPath(double startAngle, double endAngle, double outerRadius = 1, double innerRadius = 0.75)
    {
        if (endAngle - startAngle >= 360)
        {
            endAngle = startAngle + 359.99;
        }

        var startRad = (Math.PI / 180) * startAngle;
        var endRad = (Math.PI / 180) * endAngle;

        var x1 = outerRadius * Math.Cos(startRad);
        var y1 = outerRadius * Math.Sin(startRad);
        var x2 = outerRadius * Math.Cos(endRad);
        var y2 = outerRadius * Math.Sin(endRad);
        var x3 = innerRadius * Math.Cos(endRad);
        var y3 = innerRadius * Math.Sin(endRad);
        var x4 = innerRadius * Math.Cos(startRad);
        var y4 = innerRadius * Math.Sin(startRad);

        var largeArcFlag = (endAngle - startAngle) <= 180 ? "0" : "1";

        return string.Format(CultureInfo.InvariantCulture,
            "M {0} {1} A {2} {2} 0 {3} 1 {4} {5} L {6} {7} A {8} {8} 0 {3} 0 {9} {10} Z",
            x1, y1, outerRadius, largeArcFlag, x2, y2, x3, y3, innerRadius, x4, y4);
    }

    private class ChartSegment
    {
        public AccountDto Account { get; set; } = default!;
        public double Percentage { get; set; }
        public string Color { get; set; } = string.Empty;
        public double StartAngle { get; set; }
        public double EndAngle { get; set; }
    }
}