@using EasyPay.Shared.Enums.Identity

<div class="auth-card glass-panel h-100">
    <div class="d-flex justify-content-between align-items-start">
        <i class="@IconClass fs-2" style="color: @IconColor;"></i>
        <span class="status-pill @StatusPillClass">@StatusText</span>
    </div>
    <h5 class="mt-3">@Item.Title</h5>
    <p class="text-secondary small">@Item.Description</p>
    <div class="mt-auto pt-3">
        @if (Item.Status == VerificationStatus.Approved || Item.Status == VerificationStatus.Pending)
        {
            <div class="text-secondary text-center small">
                @(Item.Status == VerificationStatus.Approved ? "Verified on:" : "Submitted on:") @Item.LastStatusChangeDate?.ToString("MMM dd, yyyy")
            </div>
        }
        else
        {
            <div class="d-grid">
                <a href="@Item.ActionLink" class="btn btn-glow-error">@Item.ActionText</a>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public UserAuthItemStatusViewModel Item { get; set; }

    private string IconClass => Item.Status switch
    {
        VerificationStatus.Approved => "bi bi-patch-check-fill",
        VerificationStatus.Pending => "bi bi-clock-fill",
        _ => "bi bi-shield-lock-fill"
    };

    private string IconColor => Item.Status switch
    {
        VerificationStatus.Approved => "var(--success-color)",
        VerificationStatus.Pending => "var(--warning-color)",
        _ => "var(--error-color)"
    };

    private string StatusPillClass => Item.Status switch
    {
        VerificationStatus.Approved => "status-completed",
        VerificationStatus.Pending => "status-pending",
        _ => "status-missing"
    };

    private string StatusText => Item.Status switch
    {
        VerificationStatus.Approved => "Completed",
        VerificationStatus.Pending => "Pending Review",
        VerificationStatus.Rejected => "Rejected",
        _ => "Action Required"
    };
    public class UserAuthItemStatusViewModel
    {
        public string Title { get; set; }
        public string Description { get; set; }
        public VerificationStatus Status { get; set; }
        public DateTime? LastStatusChangeDate { get; set; }
        public string ActionText { get; set; } = "Complete Now";
        public string ActionLink { get; set; } = "/profile";
    }
}