<header class="topbar glass-panel d-flex align-items-center justify-content-between">
    <button class="btn btn-dark d-lg-none" id="sidebar-toggle" @onclick="ToggleSidebar">
        <i class="bi bi-list"></i>
    </button>
    <h4 class="d-none d-lg-block m-0">@Title</h4>
    <AuthorizeView>
        <Authorized>
            <div class="d-flex align-items-center">
                <span class="me-3 d-none d-md-inline">@context.User.FindFirst("FirstName")?.Value</span>
                <img src="https://i.pravatar.cc/40" class="rounded-circle" alt="User Avatar">
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="d-flex align-items-center">
                <a href="/login-phone" class="btn-glow">Sign In</a>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</header>

@code {
    [Parameter]
    public string Title { get; set; }

    [Parameter]
    public EventCallback OnToggleSidebar { get; set; }

    private async Task ToggleSidebar()
    {
        await OnToggleSidebar.InvokeAsync();
    }
}