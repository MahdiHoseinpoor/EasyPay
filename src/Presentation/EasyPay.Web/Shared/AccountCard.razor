@using EasyPay.Shared.DTOs.AccountManagement
@using EasyPay.Shared.Enums.AccountManagement

<div class="glass-panel p-4 h-100" @onclick="OnClickCallback">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h5 class="mb-1">@Account.Title</h5>
            @if (Account.Status == AccountStatus.Active)
            {
                <span class="badge" style="background-color: rgba(76, 175, 80, 0.2); color: var(--success-color); border: 1px solid var(--success-color);">Active</span>
            }
            else
            {
                <span class="badge" style="background-color: rgba(255, 179, 0, 0.2); color: var(--warning-color); border: 1px solid var(--warning-color);">@Account.Status.ToString()</span>
            }
        </div>
        <div class="text-end">
            <h4 class="mb-1" style="color: var(--primary-glow);">@Account.CurrentBalance.ToString("C")</h4>
            <small class="text-secondary">Rial</small>
        </div>
    </div>
    <hr style="border-color: var(--border-glass);">
    <div class="d-flex flex-wrap gap-2 mt-3">
        <button class="btn btn-outline-light btn-sm"><i class="bi bi-eye me-1"></i>View</button>
        <button class="btn btn-outline-light btn-sm"><i class="bi bi-arrow-right-short me-1"></i>Transfer</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public AccountDto Account { get; set; }

    [Parameter]
    public EventCallback OnClickCallback { get; set; }
}