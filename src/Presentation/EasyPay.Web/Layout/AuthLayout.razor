@inherits LayoutComponentBase

<main class="container d-flex align-items-center justify-content-center min-vh-100 py-5">
    <div class="row align-items-center w-100" style="max-width: 960px;">
        <div class="col-lg-6 d-none d-lg-block text-center text-lg-start pe-lg-5">
            <i class="bi bi-shield-check" style="font-size: 48px; color: var(--primary-glow);"></i>
            <h1 class="display-4 mt-2">Secure, Swift, Seamless.</h1>
            <p class="lead text-secondary mt-3">Enter the future of finance. Your digital wallet is just a step away.</p>
        </div>
        <div class="col-lg-6 col-md-12">
            <div class="glass-panel p-4 p-sm-5">
                @Body
            </div>
        </div>
    </div>
</main>