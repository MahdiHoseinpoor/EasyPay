@using EasyPay.Web.Services
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<header class="top-header">
    <h1 class="page-title">Dashboard</h1>
    <div class="profile-dropdown-container">
        <button class="profile-button" @onclick="ToggleDropdown">
            <i class="bi bi-person-circle"></i>
        </button>

        @if (isDropdownOpen)
        {
            <div class="profile-dropdown-menu">
                <div class="dropdown-header">
                    <span class="username">@context.User.Identity?.Name</span>
                    <small>Standard User</small>
                </div>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" href="/account">
                    <i class="bi bi-person"></i> My Account
                </a>
                <a class="dropdown-item" href="/settings">
                    <i class="bi bi-gear"></i> Settings
                </a>
                <div class="dropdown-divider"></div>
                <button class="dropdown-item" @onclick="BeginLogout">
                    <i class="bi bi-box-arrow-right"></i> Log Out
                </button>
            </div>
        }
    </div>
</header>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private AuthenticationState context = default!;
    private bool isDropdownOpen = false;

    protected override async Task OnInitializedAsync()
    {
        context = await AuthenticationStateTask;
    }

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private async Task BeginLogout()
    {
        await AuthService.Logout();
        NavigationManager.NavigateTo("/login-phone");
    }
}